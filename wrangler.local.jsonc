{
  "name": "zenshin-sushida-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": { "directory": "./out", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "zenshin-sushida-rankings", "database_id": "00000000-0000-4000-8000-000000000001", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "BOOTH_SESSIONS", "class_name": "BoothRoom" }] },
  "exports": { "BoothRoom": { "type": "durable-object", "storage": "sqlite" } },
  "ratelimits": [{ "name": "BOOTH_PASSWORD_ATTEMPTS", "namespace_id": "1001", "simple": { "limit": 18, "period": 60 } }]
}
